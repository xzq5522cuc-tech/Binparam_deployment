diff --git a/model_tools/tools/X2bolt/X2bolt.cpp b/model_tools/tools/X2bolt/X2bolt.cpp
index 13557e7..0cbb5ff 100644
--- a/model_tools/tools/X2bolt/X2bolt.cpp
+++ b/model_tools/tools/X2bolt/X2bolt.cpp
@@ -151,6 +151,81 @@ int main(int argc, char *argv[])
     // modified input names and output names
     modify_ms_inputs_and_outputs(ms, modifiedInputs, modifiedOutputs);
 
+
+    {
+        size_t bin_bytes = 0, f16_bytes = 0, f32_bytes = 0, other_bytes = 0;
+        int bin_count = 0, f16_count = 0, f32_count = 0, other_count = 0;
+
+        for (U32 i = 0; i < ms->num_weight_specs; i++) {
+            const auto &w = ms->ws[i];
+            switch (w.mdt) {
+                case DT_BIN01:
+                case DT_BIN11:
+                    bin_bytes += w.bytes_of_weight;
+                    bin_count++;
+                    break;
+                case DT_F16:
+                    f16_bytes += w.bytes_of_weight;
+                    f16_count++;
+                    break;
+                case DT_F32:
+                    f32_bytes += w.bytes_of_weight;
+                    f32_count++;
+                    break;
+                default:
+                    other_bytes += w.bytes_of_weight;
+                    other_count++;
+                    break;
+            }
+        }
+
+        printf("\n=== WEIGHT STORAGE SUMMARY ===\n");
+        printf("BIN  : %d tensors, %.3f MiB\n", bin_count, bin_bytes / 1024.0 / 1024.0);
+        printf("F16  : %d tensors, %.3f MiB\n", f16_count, f16_bytes / 1024.0 / 1024.0);
+        printf("F32  : %d tensors, %.3f MiB\n", f32_count, f32_bytes / 1024.0 / 1024.0);
+        printf("OTHER: %d tensors, %.3f MiB\n", other_count, other_bytes / 1024.0 / 1024.0);
+
+        size_t total = bin_bytes + f16_bytes + f32_bytes + other_bytes;
+        printf("TOTAL WEIGHTS: %.3f MiB\n", total / 1024.0 / 1024.0);
+        printf("==============================\n\n");
+    }
+
+
+    {
+        size_t target_bytes = 0;
+        int target_count = 0;
+
+        for (U32 i = 0; i < ms->num_weight_specs; i++) {
+            const auto &w = ms->ws[i];
+            std::string name = w.op_name;
+
+            bool in_layer =
+                name.find("/feature_extractor/layer1/") != std::string::npos ||
+                name.find("/feature_extractor/layer2/") != std::string::npos ||
+                name.find("/feature_extractor/layer3/") != std::string::npos ||
+                name.find("/feature_extractor/layer4/") != std::string::npos;
+
+            bool is_main_conv =
+                name.find("/conv1/Conv") != std::string::npos ||
+                name.find("/conv2/Conv") != std::string::npos ||
+                name.find("/conv3/Conv") != std::string::npos;
+
+            bool is_downsample =
+                name.find("/downsample/") != std::string::npos;
+
+            if (in_layer && is_main_conv && !is_downsample) {
+                target_bytes += w.bytes_of_weight;
+                target_count++;
+            }
+        }
+
+        printf("\n=== TARGET 48 CONV STORAGE ===\n");
+        printf("count = %d\n", target_count);
+        printf("size  = %.3f MiB\n",
+            target_bytes / 1024.0 / 1024.0);
+        printf("================================\n\n");
+    }
+
     UNI_INFO_LOG("Write bolt model to %s.\n", modelStorePath.c_str());
     CHECK_STATUS(serialize_model_to_file(ms, modelStorePath.c_str()));
     OnlineModelReclaim(onlineModel);
